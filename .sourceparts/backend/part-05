export async function loadAdminCatalog(): Promise<AdminCatalogBundle> {
  const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');
  const[categoriesRes,brandsRes,packsRes,productsRes,aliasesRes,marketsRes]=await Promise.all([
    supabase.from('categories').select('id,name').eq('is_active',true).order('sort_order'),
    supabase.from('brands').select('id,name'),
    supabase.from('pack_sizes').select('id,size_label,standard_unit,unit_multiplier'),
    supabase.from('products').select('id,name,category_id,brand_id,pack_size_id,is_local_or_imported,is_active').order('name'),
    supabase.from('product_aliases').select('product_id,alias'),
    supabase.from('markets').select('id,name,city,state,address,latitude,longitude,geofence_radius_meters,operating_hours,is_active').order('city').order('name'),
  ]);
  const responses=[categoriesRes,brandsRes,packsRes,productsRes,aliasesRes,marketsRes];const err=responses.find((r)=>r.error)?.error;if(err)throw err;
  const categories=(categoriesRes.data||[]) as Array<{id:string;name:string}>;const categoryMap=new Map(categories.map((x)=>[x.id,x.name]));const brandMap=new Map((brandsRes.data||[]).map((x:any)=>[x.id,x.name]));const packMap=new Map((packsRes.data||[]).map((x:any)=>[x.id,x]));const aliasMap=new Map<string,string[]>();(aliasesRes.data||[]).forEach((x:any)=>{const list=aliasMap.get(x.product_id)||[];list.push(x.alias);aliasMap.set(x.product_id,list);});
  return {categories,products:(productsRes.data||[]).map((row:any)=>{const pack:any=packMap.get(row.pack_size_id);return{id:row.id,name:row.name,categoryId:row.category_id,categoryName:categoryMap.get(row.category_id)||'Uncategorized',brandName:row.brand_id?String(brandMap.get(row.brand_id)||''):'',packSizeLabel:pack?.size_label||'',standardUnit:pack?.standard_unit||'',unitMultiplier:asNumber(pack?.unit_multiplier,1),origin:row.is_local_or_imported||'Local',aliases:aliasMap.get(row.id)||[],isActive:Boolean(row.is_active)} as AdminCatalogProduct;}),markets:(marketsRes.data||[]).map((row:any)=>({id:row.id,name:row.name,city:row.city,state:row.state,address:row.address,latitude:asNumber(row.latitude),longitude:asNumber(row.longitude),geofenceRadiusMeters:Number(row.geofence_radius_meters||650),operatingHours:row.operating_hours||'',isActive:Boolean(row.is_active)}))};
}
