export async function manageCatalogProduct(input:{productId?:string|null;name:string;categoryId:string;brandName?:string;packSizeLabel:string;standardUnit:string;unitMultiplier:number;origin:'Local'|'Imported'|'Both';aliases:string[];isActive:boolean;}):Promise<string>{const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');const{data,error}=await supabase.rpc('manage_catalog_product',{p_product_id:input.productId||null,p_name:input.name.trim(),p_category_id:input.categoryId,p_brand_name:input.brandName?.trim()||null,p_pack_size_label:input.packSizeLabel.trim(),p_standard_unit:input.standardUnit.trim(),p_unit_multiplier:input.unitMultiplier,p_origin:input.origin,p_aliases:input.aliases.map(x=>x.trim()).filter(Boolean),p_is_active:input.isActive});if(error)throw error;return data as string;}
export async function manageCatalogMarket(input:{marketId?:string|null;name:string;city:string;state:string;address:string;latitude:number;longitude:number;geofenceRadiusMeters:number;operatingHours?:string;isActive:boolean;}):Promise<string>{const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');const{data,error}=await supabase.rpc('manage_market',{p_market_id:input.marketId||null,p_name:input.name.trim(),p_city:input.city.trim(),p_state:input.state.trim(),p_address:input.address.trim(),p_latitude:input.latitude,p_longitude:input.longitude,p_geofence_radius_meters:input.geofenceRadiusMeters,p_operating_hours:input.operatingHours?.trim()||null,p_is_active:input.isActive});if(error)throw error;return data as string;}
export async function loadSavedProductIds():Promise<string[]>{const supabase=getSupabase();if(!supabase)return[];const{data:{user}}=await supabase.auth.getUser();if(!user)return[];const{data,error}=await supabase.from('saved_products').select('product_id').eq('user_id',user.id);if(error)throw error;return(data||[]).map((row:any)=>row.product_id);}
export async function setSavedProduct(productId:string,shouldSave:boolean):Promise<void>{const supabase=getSupabase();if(!supabase)return;const{data:{user},error:userError}=await supabase.auth.getUser();if(userError)throw userError;if(!user)return;if(shouldSave){const{error}=await supabase.from('saved_products').upsert({user_id:user.id,product_id:productId},{onConflict:'user_id,product_id'});if(error)throw error;}else{const{error}=await supabase.from('saved_products').delete().eq('user_id',user.id).eq('product_id',productId);if(error)throw error;}}

export async function uploadEvidencePhoto(file:File|Blob,mimeType?:string):Promise<{path:string}>{
 const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');const{data:{user},error:userError}=await supabase.auth.getUser();if(userError)throw userError;if(!user)throw new Error('You must be signed in as a field agent.');
 const type=mimeType||file.type||'image/jpeg';if(!['image/jpeg','image/png','image/webp'].includes(type))throw new Error('Evidence must be JPEG, PNG, or WebP.');if(file.size>10*1024*1024)throw new Error('Evidence photo must be 10 MB or smaller.');
 const extension=type==='image/png'?'png':type==='image/webp'?'webp':'jpg';const id=typeof crypto!=='undefined'&&'randomUUID'in crypto?crypto.randomUUID():`${Date.now()}-${Math.random().toString(36).slice(2)}`;const path=`${user.id}/${id}.${extension}`;
 const{error}=await supabase.storage.from('price-evidence').upload(path,file,{upsert:false,contentType:type,cacheControl:'3600'});if(error)throw error;return{path};
}
export async function createEvidenceSignedUrl(path:string|null,expiresInSeconds=900):Promise<string|null>{if(!path)return null;const supabase=getSupabase();if(!supabase)return null;const{data,error}=await supabase.storage.from('price-evidence').createSignedUrl(path,expiresInSeconds);if(error)return null;return data.signedUrl;}
export async function submitPriceObservation(input:ObservationSubmissionInput):Promise<any>{const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');const evidence=await uploadEvidencePhoto(input.evidenceFile,input.evidenceMimeType);const{data,error}=await supabase.rpc('submit_price_observation',{p_product_id:input.productId,p_market_id:input.marketId,p_price:input.price,p_quantity:1,p_unit:input.unit,p_seller_stall_desc:input.sellerStall||null,p_gps_latitude:input.location.lat,p_gps_longitude:input.location.lng,p_gps_accuracy_meters:input.location.accuracyMeters,p_captured_at:input.location.capturedAt,p_evidence_storage_path:evidence.path,p_evidence_mime_type:input.evidenceMimeType||input.evidenceFile.type||'image/jpeg'});if(error){await supabase.storage.from('price-evidence').remove([evidence.path]).catch(()=>undefined);throw error;}return data;}

