  const actorById=new Map((actorRes.data||[]).map((row:any)=>[row.id,row]));const actorAgentByUserId=new Map((actorAgentRes.data||[]).map((row:any)=>[row.user_id,row]));
  const now=new Date();const approvedReviews=verificationRes.data||[];const todayVerified=approvedReviews.filter((row:any)=>isSameUtcDay(row.verified_at,now)).length;const yesterdayDate=new Date(now.getTime()-86_400_000);const yesterdayVerified=approvedReviews.filter((row:any)=>isSameUtcDay(row.verified_at,yesterdayDate)).length;const growth=yesterdayVerified>0?((todayVerified-yesterdayVerified)/yesterdayVerified)*100:0;
  const pending=submissions.filter(sub=>['pending','flagged','recheck_requested'].includes(sub.status));const activeAgents=(agentsRes.data||[]).filter((agent:any)=>agent.is_field_active).length;const verified=submissions.filter(sub=>sub.status==='verified');const freshnessValues=verified.map(sub=>Math.max(0,(Date.now()-new Date(sub.capturedAt).getTime())/60000)).filter(Number.isFinite);const avgFreshness=freshnessValues.length?Math.round(freshnessValues.reduce((sum,n)=>sum+n,0)/freshnessValues.length):0;const confidenceValues=submissions.map(sub=>sub.systemConfidence).filter(n=>n>0);const avgConfidence=confidenceValues.length?Math.round(confidenceValues.reduce((sum,n)=>sum+n,0)/confidenceValues.length):0;const regionsCovered=new Set(verified.map(sub=>sub.marketId)).size;
  const alerts:SystemAlert[]=[];const flaggedCount=submissions.filter(sub=>sub.status==='flagged').length;const recheckCount=submissions.filter(sub=>sub.status==='recheck_requested').length;const oldPending=pending.filter(sub=>Date.now()-new Date(sub.timestamp).getTime()>24*3_600_000).length;if(flaggedCount>0)alerts.push({id:'flagged',type:'warning',title:'Anomaly queue',message:`${flaggedCount} observation(s) are flagged for review.`,count:flaggedCount,timestamp:systemAlertTimestamp()});if(recheckCount>0)alerts.push({id:'recheck',type:'info',title:'Rechecks requested',message:`${recheckCount} observation(s) are waiting for field recheck.`,count:recheckCount,timestamp:systemAlertTimestamp()});if(oldPending>0)alerts.push({id:'stale-pending',type:'warning',title:'Queue ageing',message:`${oldPending} pending observation(s) are older than 24 hours.`,count:oldPending,timestamp:systemAlertTimestamp()});
  const auditLogs:AuditLogEntry[]=(auditRes.data||[]).map((row:any)=>{const actor:any=row.actor_user_id?actorById.get(row.actor_user_id):undefined;const operationalAgent:any=row.actor_user_id?actorAgentByUserId.get(row.actor_user_id):undefined;const mapped=mapAuditDetails(row);return{id:row.id,timestamp:row.created_at,actorId:row.actor_user_id||'system',actorName:actor?.full_name||actor?.email||operationalAgent?.display_name||operationalAgent?.agent_code||'System',actorRole:row.actor_role||'system',action:row.action_type,entityType:row.entity_table==='profiles'?'profile':row.entity_table==='price_observations'?'submission':'system',entityId:row.entity_id||row.id,entityName:mapped.entityName,status:mapped.status,details:mapped.details,price:asNumber(row.new_data?.price)||undefined,confidenceScore:asNumber(row.new_data?.confidence)||undefined};});
  return{submissions,kpis:{verifiedToday:todayVerified,verifiedGrowthPercent:Math.round(growth),pendingVerification:pending.length,activeAgents,regionsCovered,averageFreshnessMinutes:avgFreshness,freshnessImprovementMinutes:0,systemConfidenceScore:avgConfidence},alerts,auditLogs};
}

export async function loadPriceAccuracyReports(status:'under_investigation'|'resolved'|'dismissed'|'all'='under_investigation'):Promise<PriceAccuracyReport[]>{const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');let query=supabase.from('reports').select('id,product_id,market_id,reported_price,discrepancy_reason,notes,status,created_at').order('created_at',{ascending:false}).limit(200);if(status!=='all')query=query.eq('status',status);const{data:rows,error}=await query;if(error)throw error;if(!rows?.length)return[];const productIds=[...new Set(rows.map((r:any)=>r.product_id))];const marketIds=[...new Set(rows.map((r:any)=>r.market_id))];const[pRes,mRes]=await Promise.all([supabase.from('products').select('id,name').in('id',productIds),supabase.from('markets').select('id,name').in('id',marketIds)]);if(pRes.error)throw pRes.error;if(mRes.error)throw mRes.error;const pm=new Map((pRes.data||[]).map((x:any)=>[x.id,x.name]));const mm=new Map((mRes.data||[]).map((x:any)=>[x.id,x.name]));return rows.map((r:any)=>({id:r.id,productId:r.product_id,productName:String(pm.get(r.product_id)||'Product'),marketId:r.market_id,marketName:String(mm.get(r.market_id)||'Market'),reportedPrice:asNumber(r.reported_price),reason:r.discrepancy_reason,notes:r.notes||null,status:r.status,createdAt:r.created_at}));}
export async function reviewPriceAccuracyReport(reportId:string,action:'resolved'|'dismissed',notes?:string):Promise<void>{const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');const{error}=await supabase.rpc('review_price_report',{p_report_id:reportId,p_action:action,p_notes:notes?.trim()||null});if(error)throw error;}
export async function submitInaccuratePriceReport(input:{productId:string;marketId:string;reportedPrice:number;reason:string;notes?:string;}){const supabase=getSupabase();if(!supabase)throw new Error('Supabase is not configured yet.');const{data:{user},error:userError}=await supabase.auth.getUser();if(userError)throw userError;if(!user)throw new Error('Please sign in before reporting an inaccurate price.');const{error}=await supabase.rpc('submit_inaccurate_price_report',{p_product_id:input.productId,p_market_id:input.marketId,p_reported_price:input.reportedPrice,p_reason:input.reason,p_notes:input.notes||null});if(error)throw error;}

