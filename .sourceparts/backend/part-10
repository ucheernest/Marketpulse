export async function submitPrivacyRequest(requestType: PrivacyRequest['request_type'], notes?: string): Promise<PrivacyRequest> {
  const supabase = getSupabase();
  if (!supabase) throw new Error('Supabase is not configured yet.');
  const { data: { user }, error: userError } = await supabase.auth.getUser();
  if (userError) throw userError;
  if (!user) throw new Error('Please sign in before submitting a privacy request.');
  const { data, error } = await supabase.from('privacy_requests').insert({ user_id: user.id, request_type: requestType, request_notes: notes?.trim() || null }).select('*').single();
  if (error) throw error;
  return data as PrivacyRequest;
}

