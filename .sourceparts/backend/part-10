export async function resolveClientError(id: string, notes?: string): Promise<void> {
  const supabase = getSupabase();
  if (!supabase) throw new Error('Supabase is not configured yet.');
  const { error } = await supabase.from('client_error_events').update({ resolved_at: new Date().toISOString(), resolution_notes: notes?.trim() || 'Reviewed' }).eq('id', id);
